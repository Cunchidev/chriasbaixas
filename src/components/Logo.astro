---
// Escudo: disco de competición amarillo/negro, barra sobre las olas de las rías.
interface Props { size?: number; class?: string; text?: boolean }
const { size = 200, class: cls = "", text = true } = Astro.props;
const id = `ring-${Math.random().toString(36).slice(2, 7)}`;
---
<svg viewBox="0 0 200 200" width={size} height={size} class={cls} role="img" aria-label="Club Halterofilia Rías Baixas">
  <defs>
    <path id={id} d="M100,100 m-79,0 a79,79 0 1,1 158,0 a79,79 0 1,1 -158,0" />
  </defs>
  <circle cx="100" cy="100" r="97" fill="#0a0a0b" />
  <circle cx="100" cy="100" r="93" fill="none" stroke="#ffd100" stroke-width="6" />
  <circle cx="100" cy="100" r="65" fill="#ffd100" />
  {text && (
    <text font-family="Anton, Impact, sans-serif" font-size="15" fill="#ffd100" letter-spacing="1.5">
      <textPath href={`#${id}`} textLength="492" lengthAdjust="spacing">CLUB HALTEROFILIA ✦ RÍAS BAIXAS ✦</textPath>
    </text>
  )}
  <text x="100" y="86" text-anchor="middle" font-family="Anton, Impact, sans-serif" font-size="40" fill="#0a0a0b">RB</text>
  <!-- barra -->
  <rect x="38" y="97" width="124" height="6" rx="2" fill="#0a0a0b" />
  <rect x="50" y="84" width="9" height="32" rx="2" fill="#0a0a0b" />
  <rect x="61" y="89" width="6" height="22" rx="2" fill="#0a0a0b" />
  <rect x="141" y="84" width="9" height="32" rx="2" fill="#0a0a0b" />
  <rect x="133" y="89" width="6" height="22" rx="2" fill="#0a0a0b" />
  <!-- rías -->
  <path d="M62 126 q9 -8 19 0 t19 0 t19 0 t19 0" fill="none" stroke="#0a0a0b" stroke-width="5" stroke-linecap="round" />
  <path d="M70 139 q7.5 -7 15 0 t15 0 t15 0 t15 0" fill="none" stroke="#0a0a0b" stroke-width="5" stroke-linecap="round" />
</svg>
