---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import { CLUB, FEDERATIONS } from "../config/club";
import { href } from "../lib/url";
interface Props { title?: string; description?: string }
const { title, description = CLUB.description } = Astro.props;
const path = Astro.url.pathname;
const fullTitle = title ? `${title} · ${CLUB.name}` : `${CLUB.name} · Halterofilia en Pontevedra`;
// Con `site` (lo pasa el workflow) las URLs son absolutas, como piden Google y las redes sociales
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const canonical = abs(path);
const ogImage = abs(href("/og.png"));
const homeUrl = abs(href("/"));
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SportsClub",
  name: CLUB.name,
  description: CLUB.description,
  url: homeUrl,
  logo: abs(href("/apple-touch-icon.png")),
  image: ogImage,
  sport: "Halterofilia",
  sameAs: [CLUB.instagram],
  address: {
    "@type": "PostalAddress",
    streetAddress: CLUB.venue.street,
    postalCode: CLUB.venue.postalCode,
    addressLocality: CLUB.venue.city,
    addressRegion: "Galicia",
    addressCountry: "ES",
  },
  memberOf: { "@type": "SportsOrganization", name: "Federación Galega de Halterofilia", url: "https://halterofilia.org/" },
};
const nav = [
  { href: "/halterofilia", label: "Halterofilia" },
  { href: "/puntos", label: "Puntos élite" },
  { href: "/calculadoras", label: "Calculadoras" },
  { href: "/calendario", label: "Calendario" },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0b" />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href("/apple-touch-icon.png")} />
    <link rel="sitemap" href={href("/sitemap-index.xml")} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={CLUB.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${CLUB.name}: levanta lo que creías imposible`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-ink text-chalk">
    <header class="fixed inset-x-0 top-0 z-50 border-b border-ink-3/60 bg-ink/80 backdrop-blur">
      <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-8">
        <a href={href("/")} class="flex shrink-0 items-center gap-3" aria-label="Inicio">
          <Logo size={40} text={false} />
          <span class="display hidden text-xl sm:inline">{CLUB.short}</span>
        </a>
        <ul class="hidden gap-7 text-sm font-medium md:flex">
          {nav.map((n) => (
            <li><a href={href(n.href)} class:list={["transition hover:text-accent", path.includes(n.href) && "text-accent"]}>{n.label}</a></li>
          ))}
        </ul>
        <!-- Menú móvil: <details> funciona sin JavaScript -->
        <details id="mobile-nav" class="group md:hidden">
          <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-ink-3 [&::-webkit-details-marker]:hidden" aria-label="Abrir menú">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path class="group-open:hidden" d="M4 7h16M4 12h16M4 17h16" />
              <path class="hidden group-open:block" d="M6 6l12 12M18 6L6 18" />
            </svg>
          </summary>
          <ul class="absolute inset-x-0 top-full border-b border-ink-3 bg-ink px-4 pb-6 pt-2">
            {nav.map((n) => (
              <li class="border-b border-ink-3 last:border-0">
                <a href={href(n.href)} class:list={["display block py-4 text-4xl", path.includes(n.href) ? "text-accent" : "hover:text-accent"]}>{n.label}</a>
              </li>
            ))}
          </ul>
        </details>
      </nav>
    </header>
    <main><slot /></main>
    <script>
      // Cierra el menú móvil al tocar fuera
      const menu = document.getElementById("mobile-nav") as HTMLDetailsElement | null;
      document.addEventListener("click", (e) => {
        if (menu?.open && !menu.contains(e.target as Node)) menu.open = false;
      });
    </script>
    <footer class="border-t border-ink-3 px-4 py-14 text-sm text-mute sm:px-8">
      <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-[auto_1fr]">
        <div class="flex items-center gap-4">
          <Logo size={88} />
          <div>
            <p class="display text-2xl text-chalk">{CLUB.name}</p>
            <a href={CLUB.instagram} target="_blank" rel="noopener" class="hover:text-accent">{CLUB.instagramHandle}</a>
            <a href={CLUB.venue.mapsUrl} target="_blank" rel="noopener" class="block hover:text-accent">{CLUB.venue.address}</a>
            <a href={CLUB.partner.url} target="_blank" rel="noopener" class="block hover:text-accent">Entrenamos en {CLUB.partner.name} ↗</a>
          </div>
        </div>
        <div>
          <p class="mb-3 text-xs uppercase tracking-[.3em] text-accent">Federaciones</p>
          <ul class="grid gap-2 sm:grid-cols-2">
            {FEDERATIONS.map((f) => (
              <li><a href={f.url} target="_blank" rel="noopener" class="hover:text-chalk"><span class="font-semibold text-chalk">{f.short}</span> · {f.name}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>
